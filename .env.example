# Скопируйте файл в .env и заполните значения (docker compose читает .env автоматически)

# Порт, на котором будет доступен frontend (nginx)
FRONTEND_PORT=3003

# Порт, на котором будет доступен backend (можно убрать, если API проксируется через frontend)
BACKEND_PORT=3005

# URL API, который вшивается в билд фронтенда.
# /api — запросы идут на тот же домен и проксируются nginx'ом на backend (рекомендуется).
# Для обращения напрямую к API укажите http://localhost:3005/api
REACT_APP_API_URL=/api

# Секрет для подписи JWT — ОБЯЗАТЕЛЬНО замените
JWT_SECRET=replace-with-a-long-random-string

# Данные почты mail.ru для отправки кодов подтверждения и сброса пароля.
# ВАЖНО: mail.ru требует пароль приложения (Настройки -> Безопасность -> Пароль приложения)
EMAIL_USER=your-mail@mail.ru
EMAIL_PASSWORD=your-app-password

# Режим локальной разработки без почты.
# true  — письма не отправляются, код 2FA печатается в логах backend
#         и показывается в окне входа на фронтенде (вход работает без настройки SMTP).
# false — коды отправляются на почту, нужны корректные EMAIL_USER/EMAIL_PASSWORD.
#         На сервере обязательно поставьте false.
DEV_2FA_CODE=true